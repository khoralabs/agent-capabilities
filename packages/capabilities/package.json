{
  "name": "@khoralabs/agent-capabilities",
  "version": "0.1.0",
  "description": "Composable toolkits, policy gates, and deterministic capability fingerprints for agent attribution.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "example:static": "bun run examples/01-static-toolkit.ts",
    "example:dynamic": "bun run examples/02-dynamic-toolkit.ts",
    "example:capabilities": "bun run examples/03-capability-snapshot.ts"
  },
  "devDependencies": {
    "@khoralabs/agent-capabilities-ai-sdk": "workspace:*",
    "@types/bun": "latest",
    "bun-types": "latest",
    "ai": "^6.0.142",
    "typescript": "^5",
    "zod": "^4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
