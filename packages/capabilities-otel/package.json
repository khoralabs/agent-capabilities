{
  "name": "@khoralabs/agent-capabilities-otel",
  "version": "0.2.0",
  "description": "OpenTelemetry and Pino telemetry adapter for @khoralabs/agent-capabilities (beta).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoralabs/agent-capabilities.git",
    "directory": "packages/capabilities-otel"
  },
  "homepage": "https://github.com/khoralabs/agent-capabilities/tree/main/packages/capabilities-otel#readme",
  "bugs": "https://github.com/khoralabs/agent-capabilities/issues",
  "keywords": [
    "agent",
    "capabilities",
    "opentelemetry",
    "otel",
    "pino",
    "telemetry",
    "observability"
  ],
  "publishConfig": {
    "tag": "beta"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@khoralabs/agent-capabilities": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@khoralabs/agent-capabilities": "^0.1.1",
    "@opentelemetry/api": "^1",
    "pino": "^9",
    "typescript": "^5"
  }
}
